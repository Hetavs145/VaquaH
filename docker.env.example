# VaquaH Docker Compose Environment
# Copy to .env at project root and fill in your values

# ── Firebase (frontend build args) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RAZORPAY_KEY_ID=

# ── AI assistant (backend) ──
# LLM providers (tried in order): OpenCode Zen -> OpenRouter -> Groq
OPENCODE_API_KEY=
OPENCODE_MODELS=deepseek-v4.1-flash-free
OPENROUTER_API_KEY=
OPENROUTER_MODELS=google/gemma-4-26b-a4b-it:free,google/gemma-4-31b-it:free
# Optional: extra LLM fallback + server-side Whisper STT fallback
GROQ_API_KEY=
